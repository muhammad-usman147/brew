# Copy this file to .env.local and fill in real values from your Supabase project
# (Supabase Dashboard -> Settings -> API). .env.local is gitignored and never committed.

# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (formerly "anon" / "public" key) - safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Secret key (formerly "service_role" key) - server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
